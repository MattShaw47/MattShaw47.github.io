---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel: Heading = 'h2' } = Astro.props;
const { title, slug, summary, publishedAt, tags } = post.data;
const postHref = `/writing/${slug}/`;
const formattedDate = publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<li class="post-preview">
  <article class="post-preview__body flow">
    <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
    <Heading class="post-preview__title">
      <a href={postHref}>{title}</a>
    </Heading>
    <p>{summary}</p>

    {tags.length > 0 && (
      <ul class="post-preview__tags" aria-label={`${title} topics`}>
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
  </article>
</li>

<style>
  .post-preview {
    position: relative;
    min-width: 0;
    list-style: none;
  }

  .post-preview__body {
    --flow-space: var(--space-3);
    height: 100%;
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
  }

  time {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-preview__title {
    margin-block-end: 0;
    font-size: var(--text-xl);
  }

  .post-preview__title a {
    text-decoration: none;
  }

  .post-preview__title a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .post-preview__title a:hover {
    color: var(--color-accent);
  }

  p {
    margin-block-end: 0;
    color: var(--color-text-muted);
    line-height: var(--leading-copy);
  }

  .post-preview__tags {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .post-preview__tags li {
    padding: 0.35rem 0.65rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 650;
    line-height: 1.2;
  }
</style>
