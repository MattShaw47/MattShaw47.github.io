---
import type { CollectionEntry } from 'astro:content';

import TechTags from './TechTags.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  primary?: boolean;
}

const { project, primary = false } = Astro.props;
const {
  title,
  slug,
  summary,
  year,
  tech,
  highlights,
  github,
  demo,
  heroImage,
  heroAlt,
  heroWidth,
  heroHeight,
  status,
  context,
} = project.data;
const projectHref = `/projects/${slug}/`;
---

<article
  class:list={[
    'project-feature',
    { 'project-feature--with-image': heroImage, 'project-feature--primary': primary },
  ]}
>
  {heroImage && (
    <div class="project-feature__media">
      <img
        src={heroImage}
        alt={heroAlt}
        width={heroWidth}
        height={heroHeight}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="project-feature__body flow">
    <div class="project-feature__meta">
      <span>{year}</span>
      {status && <span>{status}</span>}
      {context && <span>{context}</span>}
    </div>

    <h3 class="project-feature__title">
      <a class="project-feature__title-link" href={projectHref}>{title}</a>
    </h3>

    <p class="project-feature__summary">{summary}</p>
    <TechTags tech={tech} label={`Technologies used for ${title}`} />

    <ul class="project-feature__highlights" aria-label={`${title} highlights`}>
      {highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>

    <span class="project-feature__view" aria-hidden="true">View project →</span>

    {(github || demo) && (
      <div class="project-feature__actions cluster" aria-label={`${title} external links`}>
        {github && (
          <a
            class="text-link external-link"
            href={github}
            target="_blank"
            rel="noreferrer"
            aria-label={`GitHub for ${title} (opens in a new tab)`}
          >GitHub</a>
        )}
        {demo && (
          <a
            class="text-link external-link"
            href={demo}
            target="_blank"
            rel="noreferrer"
            aria-label={`Live demo for ${title} (opens in a new tab)`}
          >Live demo</a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .project-feature {
    position: relative;
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .project-feature:hover,
  .project-feature:focus-within {
    border-color: var(--color-border-strong);
    box-shadow: 0 2px 4px rgb(27 29 31 / 8%), 0 16px 40px rgb(27 29 31 / 7%);
  }

  .project-feature--primary {
    border-color: var(--color-border-strong);
  }

  .project-feature--with-image {
    grid-template-areas: 'body media';
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
  }

  .project-feature--primary.project-feature--with-image {
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 1.1fr);
  }

  .project-feature__media {
    grid-area: media;
    min-height: 100%;
    overflow: hidden;
    border-inline-start: var(--border-width) solid var(--color-border);
    background: var(--color-accent-soft);
  }

  .project-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-feature__body {
    --flow-space: var(--space-5);
    grid-area: body;
    min-width: 0;
    padding: clamp(var(--space-6), 5vw, var(--space-8));
  }

  .project-feature--primary .project-feature__body {
    padding: clamp(var(--space-7), 5vw, var(--space-9));
  }

  .project-feature__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-feature__title {
    margin-block-end: 0;
    font-size: var(--text-xl);
  }

  .project-feature--primary .project-feature__title {
    font-size: clamp(1.65rem, 1.4rem + 1vw, 2.15rem);
  }

  .project-feature__title-link {
    text-decoration: none;
  }

  .project-feature__title-link::after {
    position: absolute;
    z-index: 0;
    inset: 0;
    content: '';
  }

  .project-feature__title-link:hover {
    color: var(--color-accent);
  }

  .project-feature__summary {
    max-width: var(--width-copy);
    margin-block-end: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-copy);
  }

  .project-feature__highlights {
    display: grid;
    gap: var(--space-3);
    margin-block-end: 0;
    padding: 0;
    color: var(--color-text-muted);
    list-style: none;
  }

  .project-feature__highlights li {
    position: relative;
    padding-inline-start: var(--space-4);
    line-height: 1.55;
  }

  .project-feature__highlights li::before {
    position: absolute;
    inset-block-start: 0.65em;
    inset-inline-start: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: '';
  }

  .project-feature__view {
    color: var(--color-accent);
    font-weight: 750;
  }

  .project-feature__actions {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 48rem) {
    .project-feature--with-image,
    .project-feature--primary.project-feature--with-image {
      grid-template-areas:
        'media'
        'body';
      grid-template-columns: minmax(0, 1fr);
    }

    .project-feature__media {
      min-height: auto;
      aspect-ratio: 16 / 10;
      border-block-end: var(--border-width) solid var(--color-border);
      border-inline-start: 0;
    }

    .project-feature--primary .project-feature__body {
      padding: clamp(var(--space-6), 7vw, var(--space-7));
    }
  }
</style>
