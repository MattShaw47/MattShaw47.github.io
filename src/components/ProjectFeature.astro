---
import type { CollectionEntry } from 'astro:content';

import TechTags from './TechTags.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  slug,
  summary,
  year,
  tech,
  highlights,
  github,
  demo,
  heroImage,
  heroAlt,
  heroWidth,
  heroHeight,
  status,
} = project.data;
const projectHref = `/projects/${slug}/`;
---

<article class:list={['project-feature', { 'project-feature--with-image': heroImage }]}>
  {heroImage && (
    <div class="project-feature__media">
      <img
        src={heroImage}
        alt={heroAlt}
        width={heroWidth}
        height={heroHeight}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="project-feature__body flow">
    <div class="project-feature__meta">
      <span>{year}</span>
      {status && <span>{status}</span>}
    </div>

    <h3 class="project-feature__title">
      <a class="project-feature__title-link" href={projectHref}>{title}</a>
    </h3>

    <p class="project-feature__summary">{summary}</p>
    <TechTags tech={tech} label={`Technologies used for ${title}`} />

    <ul class="project-feature__highlights" aria-label={`${title} highlights`}>
      {highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>

    {(github || demo) && (
      <div class="project-feature__actions cluster" aria-label={`${title} external links`}>
        {github && (
          <a class="text-link external-link" href={github} target="_blank" rel="noreferrer">GitHub</a>
        )}
        {demo && (
          <a class="text-link external-link" href={demo} target="_blank" rel="noreferrer">Live demo</a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .project-feature {
    position: relative;
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
  }

  .project-feature--with-image {
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
    grid-template-areas: 'body media';
  }

  .project-feature__media {
    grid-area: media;
    min-height: 100%;
    border-inline-start: var(--border-width) solid var(--color-border);
    background: var(--color-accent-soft);
  }

  .project-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-feature__body {
    --flow-space: var(--space-5);
    grid-area: body;
    min-width: 0;
    padding: clamp(var(--space-6), 5vw, var(--space-8));
  }

  .project-feature__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-feature__title {
    margin-block-end: 0;
    font-size: var(--text-xl);
  }

  .project-feature__title-link {
    text-decoration: none;
  }

  .project-feature__title-link::after {
    position: absolute;
    z-index: 0;
    inset: 0;
    content: '';
  }

  .project-feature__title-link:hover {
    color: var(--color-accent);
  }

  .project-feature__summary {
    max-width: var(--width-copy);
    margin-block-end: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-copy);
  }

  .project-feature__highlights {
    padding-inline-start: 1.25em;
    color: var(--color-text-muted);
  }

  .project-feature__highlights li + li {
    margin-block-start: var(--space-2);
  }

  .project-feature__actions {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 48rem) {
    .project-feature--with-image {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'media'
        'body';
    }

    .project-feature__media {
      min-height: auto;
      aspect-ratio: 16 / 10;
      border-inline-start: 0;
      border-block-end: var(--border-width) solid var(--color-border);
    }
  }
</style>
