---
import type { CollectionEntry } from 'astro:content';

import TechTags from './TechTags.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  slug,
  summary,
  year,
  tech,
  github,
  demo,
  heroImage,
  heroAlt,
  heroWidth,
  heroHeight,
  status,
} = project.data;
const projectHref = `/projects/${slug}/`;
---

<article class:list={['project-card', { 'project-card--with-image': heroImage }]}>
  {heroImage && (
    <div class="project-card__media">
      <img
        src={heroImage}
        alt={heroAlt}
        width={heroWidth}
        height={heroHeight}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="project-card__body flow">
    <div class="project-card__meta">
      <span>{year}</span>
      {status && <span>{status}</span>}
    </div>

    <h2 class="project-card__title">
      <a class="project-card__title-link" href={projectHref}>{title}</a>
    </h2>

    <p class="project-card__summary">{summary}</p>
    <TechTags tech={tech} label={`Technologies used for ${title}`} />

    {(github || demo) && (
      <div class="project-card__actions cluster" aria-label={`${title} external links`}>
        {github && (
          <a class="text-link external-link" href={github} target="_blank" rel="noreferrer">GitHub</a>
        )}
        {demo && (
          <a class="text-link external-link" href={demo} target="_blank" rel="noreferrer">Live demo</a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
  }

  .project-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-block-end: var(--border-width) solid var(--color-border);
    background: var(--color-accent-soft);
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__body {
    --flow-space: var(--space-4);
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: var(--space-6);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-card__title {
    margin-block-end: 0;
    font-size: var(--text-xl);
  }

  .project-card__title-link {
    text-decoration: none;
  }

  .project-card__title-link::after {
    position: absolute;
    z-index: 0;
    inset: 0;
    content: '';
  }

  .project-card__title-link:hover {
    color: var(--color-accent);
  }

  .project-card__summary {
    margin-block-end: 0;
    color: var(--color-text-muted);
    line-height: var(--leading-copy);
  }

  .project-card__actions {
    position: relative;
    z-index: 1;
    margin-block-start: auto;
    padding-block-start: var(--space-3);
  }

  @media (max-width: 36rem) {
    .project-card__body {
      padding: var(--space-5);
    }
  }
</style>
