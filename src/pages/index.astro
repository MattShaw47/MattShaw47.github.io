---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Matthew Shaw — Portfolio';
const pageDescription = 'Personal software engineering portfolio for Matthew Shaw.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="intro container flow" aria-labelledby="intro-title">
    <p class="eyebrow">Software engineer</p>
    <h1 id="intro-title">Thoughtful software built for people and the problems they actually face.</h1>
    <p class="intro__summary">
      This is representative copy for testing a longer portfolio introduction. Project content and
      final biography details will be added in later phases without changing the shared layout.
    </p>
    <div class="cluster">
      <a class="button" href="#foundation">Explore the foundation</a>
      <a class="button button--secondary" href="https://github.com/MattShaw47" target="_blank" rel="noreferrer">
        <span class="external-link">GitHub</span>
      </a>
    </div>
  </section>

  <section id="foundation" class="foundation container" aria-labelledby="foundation-title">
    <div class="prose">
      <h2 id="foundation-title">A flexible foundation for the work still to come</h2>
      <p>
        The shared design system uses responsive type, fluid spacing, visible keyboard focus, and
        layouts that wrap naturally. This temporary content exercises those rules before project
        data is introduced.
      </p>
      <ul class="tech-tags" aria-label="Foundation technologies">
        <li class="tech-tag">Astro</li>
        <li class="tech-tag">TypeScript</li>
        <li class="tech-tag">Accessible HTML</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    --flow-space: var(--space-5);
    padding-block: clamp(var(--space-8), 12vw, 8rem);
  }

  .eyebrow {
    margin-block-end: 0;
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin-block-end: 0;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .intro__summary {
    max-width: var(--width-copy);
    margin-block-end: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-copy);
  }

  .foundation {
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .foundation .prose {
    margin-inline: auto;
  }

  @media (max-width: 36rem) {
    .intro .cluster {
      align-items: stretch;
    }
  }
</style>
