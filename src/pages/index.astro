---
import { getCollection } from 'astro:content';

import PostPreview from '../components/PostPreview.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../utils/posts';

const pageTitle = 'Matthew Shaw — Portfolio';
const pageDescription = 'Personal software engineering portfolio for Matthew Shaw.';

const sampleCopy = {
  hero: {
    eyebrow: ''Computer Science · University of Utah',
    title: 'I build software that connects practical problems with interesting technical systems.',
    summary:
      'I’m a Computer Science student at the University of Utah interested in software engineering, systems, and applied machine learning. My work ranges from desktop and mobile applications to networking, OCR, cloud services, and low-level experimentation.',
  },
  projects: {
    eyebrow: 'Selected work',
    title: 'Featured projects',
    introduction:
      'A selection of projects spanning desktop software, mobile development, networking, and applied computer vision.',
  },
  writing: {
    eyebrow: 'Writing',
    title: 'Notes on building software',
    introduction:
      'Replace this sample introduction with a short description of the subjects covered by your published writing.',
  },
  about: {
    eyebrow: 'About and contact',
    title: 'Replace this heading with a short, personal introduction.',
    biography:
      'Replace this sample biography with a focused overview of your background, the kinds of teams or products you work best with, and the perspective you bring to software engineering.',
    contact:
      'Replace this sample contact note with the preferred way for employers, collaborators, or clients to reach you. Add only the final email address or profile links you want to publish.',
  },
};

const projects = await getCollection('projects');
const featuredProjects = projects
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);

if (featuredProjects.length !== 3) {
  throw new Error(
    `Homepage configuration error: expected exactly 3 featured projects, but found ${featuredProjects.length}. Check the featured and featuredOrder fields in src/content/projects/.`,
  );
}

const publishedPosts = await getPublishedPosts();
const hasPublishedPosts = publishedPosts.length > 0;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="hero container flow" aria-labelledby="hero-title">
    <p class="eyebrow">{sampleCopy.hero.eyebrow}</p>
    <h1 id="hero-title">{sampleCopy.hero.title}</h1>
    <p class="hero__summary">{sampleCopy.hero.summary}</p>
    <a class="button" href="#featured-projects">View featured projects</a>
  </section>

  <section id="featured-projects" class="section container" aria-labelledby="projects-title">
    <div class="section__heading flow">
      <p class="eyebrow">{sampleCopy.projects.eyebrow}</p>
      <h2 id="projects-title">{sampleCopy.projects.title}</h2>
      <p>{sampleCopy.projects.introduction}</p>
    </div>

    <div class="project-list">
      {featuredProjects.map((project) => <ProjectFeature project={project} />)}
    </div>

    <a class="text-link" href="/projects/">View all projects</a>
  </section>

  {hasPublishedPosts && (
    <section id="writing" class="section section--bordered container" aria-labelledby="writing-title">
      <div class="section__heading flow">
        <p class="eyebrow">{sampleCopy.writing.eyebrow}</p>
        <h2 id="writing-title">{sampleCopy.writing.title}</h2>
        <p>{sampleCopy.writing.introduction}</p>
      </div>

      <ul class="writing-list">
        {publishedPosts.slice(0, 3).map((post) => <PostPreview post={post} headingLevel="h3" />)}
      </ul>

      <a class="text-link" href="/writing/">View all writing</a>
    </section>
  )}

  <section id="about" class="section section--bordered container" aria-labelledby="about-title">
    <div class="about-grid">
      <div class="section__heading flow">
        <p class="eyebrow">{sampleCopy.about.eyebrow}</p>
        <h2 id="about-title">{sampleCopy.about.title}</h2>
      </div>

      <div class="about-copy flow">
        <p>{sampleCopy.about.biography}</p>
        <p>{sampleCopy.about.contact}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    --flow-space: var(--space-5);
    padding-block: clamp(var(--space-8), 10vw, 7rem);
  }

  .eyebrow {
    margin-block-end: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 19ch;
    margin-block-end: 0;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .hero__summary {
    max-width: var(--width-copy);
    margin-block-end: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-copy);
  }

  .section {
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    scroll-margin-block-start: var(--space-5);
  }

  .section--bordered {
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .section__heading {
    --flow-space: var(--space-4);
    max-width: var(--width-copy);
  }

  .section__heading h2 {
    margin-block-end: 0;
    font-size: var(--text-xl);
  }

  .section__heading p:last-child,
  .about-copy,
  .writing-list p {
    color: var(--color-text-muted);
    line-height: var(--leading-copy);
  }

  .project-list {
    display: grid;
    gap: var(--space-6);
    margin-block: var(--space-7) var(--space-6);
  }

  .writing-list {
    display: grid;
    gap: var(--space-5);
    margin-block: var(--space-7) var(--space-6);
    padding: 0;
    list-style: none;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-7);
    align-items: start;
  }

  .about-copy {
    --flow-space: var(--space-5);
    max-width: var(--width-copy);
    font-size: var(--text-lg);
  }

  .about-copy p {
    margin-block-end: 0;
  }

  @media (max-width: 48rem) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
