---
const pageTitle = 'Matthew Shaw — Portfolio';
const pageDescription = 'Personal software engineering portfolio for Matthew Shaw.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <h1>Matthew Shaw</h1>
      <p>The portfolio scaffold is ready. Project content will be added in a later phase.</p>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-width: 20rem;
    color: #171717;
    background: #fafafa;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  main {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
    padding-block: clamp(4rem, 12vw, 9rem);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  p {
    max-width: 42rem;
    margin-block: 1.5rem 0;
    color: #666;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
  }
</style>
