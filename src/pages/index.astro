---
import { getCollection } from 'astro:content';

import ContactLinks from '../components/ContactLinks.astro';
import PostPreview from '../components/PostPreview.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import { contactDetails } from '../config/contact';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../utils/posts';

const pageTitle = 'Matthew Shaw — Portfolio';
const pageDescription = 'Personal software engineering portfolio for Matthew Shaw.';

const sampleCopy = {
  hero: {
    eyebrow: 'Computer Science · University of Utah',
    title: 'Computer Science student building desktop, mobile, and systems software.',
    summary:
      'I’m a Computer Science student at the University of Utah interested in software engineering, systems, and applied machine learning. My work ranges from desktop and mobile applications to networking, OCR, cloud services, and low-level experimentation.',
  },
  projects: {
    eyebrow: 'Selected work',
    title: 'Featured projects',
    introduction:
      'A few projects that show how I approach software across desktop applications, Android development, computer vision, and networking. Each project page goes deeper into the implementation and technical decisions.',
  },
  writing: {
    eyebrow: 'Writing',
    title: 'Notes on building software',
    introduction:
      'Replace this sample introduction with a short description of the subjects covered by your published writing.',
  },
  about: {
    eyebrow: 'About',
    title: 'Computer Science student at the University of Utah.',
    biography:
      "I'm finishing my B.S. in Computer Science at the University of Utah, graduating Spring 2027. I enjoy software projects where I can understand and work across the system rather than treating each layer as a black box—from user interfaces and application architecture to networking, data processing, and deployment. I'm currently looking for software engineering internships and early-career opportunities.",
    contact:
      'I’m currently interested in software engineering internships and early-career opportunities. You can find my work on GitHub or contact me through LinkedIn or email.',
  },
};

const projects = await getCollection('projects');
const featuredProjects = projects
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);

if (featuredProjects.length !== 3) {
  throw new Error(
    `Homepage configuration error: expected exactly 3 featured projects, but found ${featuredProjects.length}. Check the featured and featuredOrder fields in src/content/projects/.`,
  );
}

const publishedPosts = await getPublishedPosts();
const hasPublishedPosts = publishedPosts.length > 0;
const hasAdditionalProjects = projects.length > featuredProjects.length;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="hero container flow" aria-labelledby="hero-title">
    <p class="eyebrow">{sampleCopy.hero.eyebrow}</p>
    <h1 id="hero-title">Matthew Shaw</h1>
    <p class="hero__role">{sampleCopy.hero.title}</p>
    <p class="hero__summary">{sampleCopy.hero.summary}</p>
    <div class="hero__actions cluster">
      <a class="button" href="#featured-projects">View projects</a>
      {contactDetails.resume && (
        <a
          class="button button--secondary external-link"
          href={contactDetails.resume}
          target="_blank"
          rel="noreferrer"
          aria-label="Résumé (opens in a new tab)"
        >Résumé</a>
      )}
      {contactDetails.github && (
        <a
          class="button button--secondary external-link"
          href={contactDetails.github}
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub (opens in a new tab)"
        >GitHub</a>
      )}
    </div>
  </section>

  <section id="featured-projects" class="section container" aria-labelledby="projects-title">
    <div class="section__heading flow">
      <p class="eyebrow">{sampleCopy.projects.eyebrow}</p>
      <h2 id="projects-title">{sampleCopy.projects.title}</h2>
      <p>{sampleCopy.projects.introduction}</p>
    </div>

    <div class="project-list">
      {featuredProjects.map((project, index) => (
        <ProjectFeature project={project} primary={index === 0} />
      ))}
    </div>

    {hasAdditionalProjects && <a class="text-link" href="/projects/">View all projects</a>}
  </section>

  {hasPublishedPosts && (
    <section id="writing" class="section section--bordered container" aria-labelledby="writing-title">
      <div class="section__heading flow">
        <p class="eyebrow">{sampleCopy.writing.eyebrow}</p>
        <h2 id="writing-title">{sampleCopy.writing.title}</h2>
        <p>{sampleCopy.writing.introduction}</p>
      </div>

      <ul class="writing-list">
        {publishedPosts.slice(0, 3).map((post) => <PostPreview post={post} headingLevel="h3" />)}
      </ul>

      <a class="text-link" href="/writing/">View all writing</a>
    </section>
  )}

  <div class="section section--bordered container about-contact-grid">
    <section id="about" class="about-panel flow" aria-labelledby="about-title">
      <p class="eyebrow">{sampleCopy.about.eyebrow}</p>
      <h2 id="about-title">{sampleCopy.about.title}</h2>
      <div class="about-copy flow">
        <p>{sampleCopy.about.biography}</p>
      </div>
    </section>

    <section id="contact" class="contact-panel flow" aria-labelledby="contact-title">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Ways to connect</h2>
      <p class="contact-copy">{sampleCopy.about.contact}</p>
      <ContactLinks />
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    --flow-space: var(--space-4);
    padding-block: clamp(var(--space-6), 5vw, var(--space-8));
  }

  .eyebrow {
    margin-block-end: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    margin-block-end: 0;
    font-size: clamp(2.75rem, 2rem + 4vw, 4.25rem);
    letter-spacing: var(--tracking-tight);
  }

  .hero__role {
    max-width: 34ch;
    margin-block-end: 0;
    color: var(--color-text);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.3;
  }

  .hero__summary {
    max-width: var(--width-copy);
    margin-block-end: 0;
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-copy);
  }

  .hero__actions {
    --cluster-gap: var(--space-3);
    padding-block-start: var(--space-2);
  }

  .section {
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    scroll-margin-block-start: var(--space-5);
  }

  .section--bordered {
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .section__heading {
    --flow-space: var(--space-4);
    max-width: var(--width-copy);
  }

  .section__heading h2 {
    margin-block-end: 0;
    font-size: var(--text-xl);
  }

  .section__heading p:last-child,
  .about-copy,
  .writing-list p {
    color: var(--color-text-muted);
    line-height: var(--leading-copy);
  }

  .project-list {
    display: grid;
    gap: var(--space-6);
    margin-block: var(--space-7) var(--space-6);
  }

  .writing-list {
    display: grid;
    gap: var(--space-5);
    margin-block: var(--space-7) var(--space-6);
    padding: 0;
    list-style: none;
  }

  .about-contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(var(--space-7), 8vw, var(--space-9));
    align-items: start;
  }

  .about-panel,
  .contact-panel {
    --flow-space: var(--space-4);
    scroll-margin-block-start: calc(var(--header-height) + var(--space-4));
  }

  .about-panel h2,
  .contact-panel h2 {
    margin-block-end: 0;
    font-size: var(--text-xl);
  }

  .about-copy,
  .contact-copy {
    --flow-space: var(--space-5);
    max-width: var(--width-copy);
    font-size: var(--text-base);
  }

  .about-copy p {
    margin-block-end: 0;
  }

  @media (max-width: 48rem) {
    .about-contact-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
</style>
