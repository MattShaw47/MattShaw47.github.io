---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Matthew Shaw"
  description="The requested page could not be found on Matthew Shaw's portfolio."
>
  <section class="not-found container flow" aria-labelledby="not-found-title">
    <p class="not-found__code">404</p>
    <h1 id="not-found-title">That page could not be found.</h1>
    <p>
      The address may be outdated or mistyped. Return to the portfolio homepage or browse the
      available projects.
    </p>
    <div class="cluster">
      <a class="button" href="/">Return home</a>
      <a class="button button--secondary" href="/projects/">Browse projects</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    --flow-space: var(--space-5);
    padding-block: clamp(var(--space-8), 12vw, 9rem);
  }

  .not-found__code {
    margin-block-end: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  h1 {
    max-width: 16ch;
    margin-block-end: 0;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .not-found > p:not(.not-found__code) {
    max-width: var(--width-copy);
    margin-block-end: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-copy);
  }
</style>
