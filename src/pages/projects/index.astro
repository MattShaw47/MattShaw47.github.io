---
import { getCollection } from 'astro:content';

import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
];
---

<BaseLayout
  title="Projects — Matthew Shaw"
  description="Selected software engineering projects by Matthew Shaw."
  navItems={navItems}
>
  <header class="projects-header container flow">
    <p class="projects-header__eyebrow">Selected work</p>
    <h1>Projects</h1>
    <p>
      Representative project content demonstrating a range of technical challenges, interface
      decisions, and optional media and links.
    </p>
  </header>

  <section class="projects-list container" aria-label="Project list">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>

<style>
  .projects-header {
    --flow-space: var(--space-4);
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
  }

  .projects-header__eyebrow {
    margin-block-end: 0;
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-block-end: 0;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .projects-header > p:last-child {
    max-width: var(--width-copy);
    margin-block-end: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-copy);
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    padding-block-end: clamp(var(--space-8), 10vw, var(--space-9));
  }

  @media (max-width: 48rem) {
    .projects-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
