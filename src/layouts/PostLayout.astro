---
import type { CollectionEntry } from 'astro:content';

import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, summary, publishedAt, updatedAt, tags } = post.data;
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<BaseLayout title={`${title} — Matthew Shaw`} description={summary}>
  <article class="post-detail container">
    <header class="post-detail__header flow">
      <a class="text-link post-detail__back" href="/writing/">All writing</a>
      <div class="post-detail__dates">
        <span>Published <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time></span>
        {updatedAt && (
          <span>Updated <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></span>
        )}
      </div>
      <h1>{title}</h1>
      <p class="post-detail__summary">{summary}</p>

      {tags.length > 0 && (
        <ul class="tech-tags" aria-label="Post topics">
          {tags.map((tag) => <li class="tech-tag">{tag}</li>)}
        </ul>
      )}
    </header>

    <div class="post-detail__content prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-detail {
    width: min(100% - (2 * var(--gutter)), var(--width-copy));
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
  }

  .post-detail__header {
    --flow-space: var(--space-5);
    padding-block-end: clamp(var(--space-7), 7vw, var(--space-8));
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .post-detail__back {
    display: inline-block;
  }

  .post-detail__back::before {
    content: '←\00a0';
  }

  .post-detail__dates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin-block-end: 0;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .post-detail__summary {
    margin-block-end: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-copy);
  }

  .post-detail__content {
    padding-block-start: clamp(var(--space-7), 7vw, var(--space-8));
  }
</style>
