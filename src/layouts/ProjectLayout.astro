---
import type { CollectionEntry } from 'astro:content';

import TechTags from '../components/TechTags.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  summary,
  year,
  tech,
  highlights,
  github,
  demo,
  heroImage,
  heroAlt,
  heroWidth,
  heroHeight,
  status,
} = project.data;

---

<BaseLayout
  title={`${title} — Matthew Shaw`}
  description={summary}
  image={heroImage}
  imageAlt={heroAlt}
  imageWidth={heroWidth}
  imageHeight={heroHeight}
  type="article"
>
  <article class="project-detail">
    <header class:list={['project-detail__hero', 'container', { 'project-detail__hero--with-image': heroImage }]}>
      {heroImage && (
        <div class="project-detail__media">
          <img
            src={heroImage}
            alt={heroAlt}
            width={heroWidth}
            height={heroHeight}
            decoding="async"
            fetchpriority="high"
          />
        </div>
      )}

      <div class="project-detail__intro flow">
        <a class="text-link project-detail__back" href="/projects/">All projects</a>
        <div class="project-detail__meta">
          <span>{year}</span>
          {status && <span>{status}</span>}
        </div>
        <h1>{title}</h1>
        <p class="project-detail__summary">{summary}</p>
        <TechTags tech={tech} label={`Technologies used for ${title}`} />

        {(github || demo) && (
          <div class="cluster">
            {demo && (
              <a class="button" href={demo} target="_blank" rel="noreferrer">
                <span class="external-link">View live demo</span>
              </a>
            )}
            {github && (
              <a class="button button--secondary" href={github} target="_blank" rel="noreferrer">
                <span class="external-link">View on GitHub</span>
              </a>
            )}
          </div>
        )}
      </div>
    </header>

    <div class="project-detail__content container">
      <div class="prose">
        <slot />
      </div>

      <aside class="project-detail__highlights" aria-labelledby="project-highlights-title">
        <h2 id="project-highlights-title">Project highlights</h2>
        <ul>
          {highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail__hero {
    display: grid;
    gap: clamp(var(--space-7), 6vw, var(--space-9));
    align-items: center;
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
  }

  .project-detail__hero--with-image {
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.9fr);
    grid-template-areas: 'intro media';
  }

  .project-detail__media {
    grid-area: media;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    box-shadow: var(--shadow-subtle);
  }

  .project-detail__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-detail__intro {
    --flow-space: var(--space-5);
    grid-area: intro;
    min-width: 0;
  }

  .project-detail__back {
    display: inline-block;
  }

  .project-detail__back::before {
    content: '←\00a0';
  }

  .project-detail__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 20ch;
    margin-block-end: 0;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .project-detail__summary {
    max-width: var(--width-copy);
    margin-block-end: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-copy);
  }

  .project-detail__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.42fr);
    gap: clamp(var(--space-7), 8vw, var(--space-9));
    align-items: start;
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .project-detail__highlights {
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .project-detail__highlights h2 {
    margin-block-end: var(--space-4);
    font-size: var(--text-lg);
  }

  .project-detail__highlights ul {
    margin-block-end: 0;
    padding-inline-start: 1.25em;
    color: var(--color-text-muted);
  }

  .project-detail__highlights li + li {
    margin-block-start: var(--space-3);
  }

  @media (max-width: 48rem) {
    .project-detail__hero--with-image {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'media'
        'intro';
    }

    .project-detail__content {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
